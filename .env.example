# Copy this file to .env.local and paste your key there.
# .env.local is gitignored; this template is committed, so never put a real key here.
# Get a free key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your_key_here

# Optional. Leave these unset unless you need to pin a specific model.
# By default the app tries gemini-flash-latest, then 3.5-flash, then 3-flash,
# and uses whichever your key can reach. Set these only to override that.
# GEMINI_VISION_MODEL=gemini-flash-latest
# GEMINI_CHAT_MODEL=gemini-flash-latest
