# Copy this file to .env.local and paste your key there.
# .env.local is gitignored; this template is committed, so never put a real key here.
# Get a free key at https://aistudio.google.com/apikey (no credit card needed)
GEMINI_API_KEY=your_key_here

# Optional overrides
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_CHAT_MODEL=gemini-2.5-flash
