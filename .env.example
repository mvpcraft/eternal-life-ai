# Copy this file to .env.local and paste your key there.
# .env.local is gitignored; this template is committed, so never put a real key here.
# Get a free key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# Optional. Text model for chat and the style profile.
# Falls back automatically if this one is unavailable or rate-limited.
LLM_MODEL="openai/gpt-oss-20b:free"

# Optional. Must be vision-capable: it reads the screenshots.
# gpt-oss-20b is text-only and cannot do this step.
LLM_VISION_MODEL="google/gemma-4-31b-it:free"

# Optional. Used for OpenRouter attribution headers.
# APP_URL=https://your-app.vercel.app
